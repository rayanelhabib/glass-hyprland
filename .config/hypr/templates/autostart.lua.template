hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE QT_QPA_PLATFORM")
    hl.exec_cmd("systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE QT_QPA_PLATFORM")
    hl.exec_cmd("hyprctl seterror disable")
    -- hyprglass MUST be loaded from here, not from config/plugins.lua. Loading
    -- a plugin during config load makes Hyprland 0.56.1 recurse between
    -- reload() and handlePluginLoads() until the stack blows, segfaulting the
    -- compositor and dropping the whole session at the login screen.
    hl.exec_cmd("~/.config/hypr/scripts/hyprglass_startup.sh")
    -- Floating-window clamp daemon (keeps floaters off the top bar / screen edges)
    hl.exec_cmd("~/.config/hypr/scripts/window_clamp.sh")
    -- "Drop and stay" daemon (re-floats windows where you dropped them after a drag)
    hl.exec_cmd("~/.config/hypr/scripts/floating_drag.sh")
    -- Auto-clean stale Antigravity singletons after session crashes
    hl.exec_cmd("~/.config/hypr/scripts/fix_antigravity_locks.sh")
