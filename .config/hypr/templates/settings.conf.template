#  ◈ SETTINGS (AUTOGENERATED FROM SETTINGS.JSON)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

general {
    border_size = 2
    gaps_in = 4
    gaps_out = 4
    float_gaps = 6
    resize_on_border = true
    extend_border_grab_area = 30
    col.active_border=$active_border
    col.inactive_border=$inactive_border 
}

decoration {
    rounding = 10
    active_opacity = 1.0
    inactive_opacity = 0.97
    blur {
        enabled = true
        size = 8
        passes = 2
        new_optimizations = true
    }
    shadow {
        enabled = true
        range = 14
        render_power = 3
        color = 0x00000073
        color_inactive = 0x0000004d
    }
}

input {
    kb_layout = {{KB_LAYOUT}}
    kb_options = {{KB_OPTIONS}}

    touchpad {
        natural_scroll = true
    }
}

cursor {
    no_warps = true
}

misc {
    font_family = JetBrains Mono
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
    # VRR always-on caused flicker/black frames on this panel; 0 = off (stable)
    vrr = 0
}

ecosystem {
    no_update_news = true
    no_donation_nag = true
}

animations {
    enabled = yes
    bezier = easeOutExpo, 0.16, 1, 0.3, 1
    bezier = snappy, 0.05, 0.9, 0.1, 1.05
    bezier = overshoot, 0.05, 1.4, 0.4, 1
    bezier = soft, 0.4, 0, 0.2, 1
    bezier = linear, 0, 0, 1, 1
    animation = windows, 1, 6, easeOutExpo, popin 87%
    animation = windowsIn, 1, 6, easeOutExpo, popin 87%
    animation = windowsOut, 1, 4, easeOutExpo, popin 80%
    animation = windowsMove, 1, 5, easeOutExpo, slide
    animation = fade, 1, 4, soft
    animation = fadeIn, 1, 4, soft
    animation = fadeOut, 1, 4, soft
    animation = fadeSwitch, 1, 4, soft
    animation = fadeDim, 1, 5, soft
    animation = workspaces, 1, 6, easeOutExpo, slide
    animation = workspacesIn, 1, 6, easeOutExpo, slide
    animation = workspacesOut, 1, 6, easeOutExpo, slide
    animation = border, 1, 8, snappy
    animation = borderangle, 1, 180, linear, loop
    animation = layers, 1, 5, easeOutExpo, fade
    animation = layersIn, 1, 5, easeOutExpo, fade
    animation = layersOut, 1, 5, easeOutExpo, fade
    animation = specialWorkspace, 1, 5, easeOutExpo, slidefade
    animation = specialWorkspaceIn, 1, 5, easeOutExpo, slidefade
    animation = specialWorkspaceOut, 1, 5, easeOutExpo, slidefade
}
