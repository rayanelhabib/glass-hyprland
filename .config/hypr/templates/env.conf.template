#  ◈ ENVIRONMENT VARIABLES (AUTOGENERATED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

env = NIXOS_OZONE_WL,1
env = XDG_PICTURES_DIR,{{XDG_PICTURES_DIR}}
env = XDG_VIDEOS_DIR,{{XDG_VIDEOS_DIR}}
env = WALLPAPER_DIR,{{WALLPAPER_DIR}}
env = SCRIPT_DIR,{{SCRIPT_DIR}}
env = QT_QPA_PLATFORMTHEME,qt6ct
env = HYPRCURSOR_THEME,Bibata-Modern-Amber
env = HYPRCURSOR_SIZE,24
env = XCURSOR_THEME,Bibata-Modern-Amber
env = XCURSOR_SIZE,24

# Toolkit & Session Wayland variables
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = GDK_BACKEND,wayland,x11,*
env = QT_QPA_PLATFORM,wayland;xcb
env = SDL_VIDEODRIVER,wayland
env = CLUTTER_BACKEND,wayland

# Memory & Performance Optimizations (glibc malloc trim & RAM release)
env = MALLOC_TRIM_THRESHOLD_,131072
env = MALLOC_MMAP_THRESHOLD_,131072
env = MALLOC_ARENA_MAX,4

# Hardware Acceleration Options (AMD Radeon iGPU + NVIDIA dGPU)
# NOTE: AQ_DRM_DEVICES is split on ":" so the PCI by-path (pci-0000:06:00.0) breaks
# it and Hyprland finds no GPUs -> crash -> back to login. Auto-detect instead.
# env = AQ_DRM_DEVICES,/dev/dri/card2:/dev/dri/card1
env = ELECTRON_OZONE_PLATFORM_HINT,auto
env = LIBVA_DRIVER_NAME,radeonsi
env = VDPAU_DRIVER,radeonsi

